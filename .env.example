# ==============================================================================
# Customer Feedback Text Mining + RAG - Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in your values:
#   copy .env.example .env   (Windows PowerShell: cp .env.example .env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API Configuration
# ------------------------------------------------------------------------------
# Required for:
#   - LLM insight generation (root-cause analysis, policy recommendations)
#   - Google embeddings (when EMBEDDING_PROVIDER=gemini)
# Get a free API key at: https://aistudio.google.com/
# If left empty, the RAG system automatically falls back to offline heuristic synthesis.
GEMINI_API_KEY=your_gemini_api_key_here

# LLM model used for report and insight generation
# Recommended options: gemini-2.5-flash (fast, high quality), gemini-1.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Embedding Model Provider
# ------------------------------------------------------------------------------
# Choose how text vectors are generated:
#   - "local"  : Uses HuggingFace sentence-transformers (all-MiniLM-L6-v2, 384 dims).
#                100% free, runs offline on your CPU/GPU, no API rate limits. (Recommended for large datasets)
#   - "gemini" : Uses Google text-embedding-004 (768 dims).
#                High accuracy, calls Google API (requires GEMINI_API_KEY).
EMBEDDING_PROVIDER=local

# ------------------------------------------------------------------------------
# 3. Vector Database & Storage Paths (Optional overrides)
# ------------------------------------------------------------------------------
VECTOR_STORE_DIR=data/vector_store
PROCESSED_DATA_DIR=data/processed
POLICIES_DIR=docs/policies
