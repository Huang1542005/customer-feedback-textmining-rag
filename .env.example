# Environment Variables for Customer Feedback Text Mining & RAG

# Google Gemini API Key (used for LLM answer generation and optional Gemini embeddings)
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default LLM Model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Embedding provider ("local" for offline sentence-transformers, "gemini" for Gemini text-embedding-004)
EMBEDDING_PROVIDER=local
